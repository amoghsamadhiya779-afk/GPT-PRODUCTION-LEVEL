# .gitignore — GPT-PRODUCTION-LEVEL

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/

# PyTorch
*.pth
*.pt
checkpoints/*
!checkpoints/adapters/
checkpoints_tiny/
models/

# Training outputs
logs/
logs_tiny/
*.pdf
loss.png

# Data
data/*.txt
!data/download.py

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Misc
.sixth/
.pytest_cache/
mlflow.db
mlflow.db.bak*
mlruns/
node-env/
venv_prod/
frontend/node_modules/
data/feedback.jsonl
.env

# training/train.py writes these as scratch files when splitting instruction
# data, and only cleans them up on a successful run -- ignore so a crashed
# run doesn't leave them as stray untracked files.
tests/temp_train.json
tests/temp_val.json

!checkpoints/adapters/*.pt
