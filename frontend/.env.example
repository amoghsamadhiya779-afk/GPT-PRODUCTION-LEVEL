# .env.example — GPT-PRODUCTION-LEVEL frontend
#
# Copy to .env.local for local development (Next.js loads .env.local
# automatically). On Vercel, set this in the project's Environment Variables
# settings instead.

# Base URL of the FastAPI backend. Intentionally public (NEXT_PUBLIC_*) --
# the browser calls this directly. Must match ALLOWED_ORIGINS on the backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
