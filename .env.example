# .env.example — GPT-PRODUCTION-LEVEL backend (app/)
#
# Copy to .env for local development, or set these in your deployment
# platform's environment settings (e.g. Hugging Face Space secrets/variables).
# None of these are read from a .env file automatically by the app itself --
# they're plain os.environ lookups, so export them however your shell/host
# supports (`python-dotenv`, HF Space secrets, docker-compose `environment:`, etc).

# Path to the base model checkpoint. If unset, falls back to
# checkpoints/best_model.pt, then checkpoints_tiny/best_model.pt, then an
# untrained dummy model while real weights download in the background.
MODEL_CHECKPOINT=checkpoints/best_model.pt

# Name of a LoRA adapter (checkpoints/adapters/<name>.pt) to auto-activate on
# top of the base checkpoint at startup, e.g. an SFT instruction-tuning
# adapter. Optional.
DEFAULT_ADAPTER=sft_v1_small

# Comma-separated list of origins allowed by CORS. Must include your deployed
# frontend's exact origin (scheme + host, no path) or browser requests from
# it will be blocked.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# API key for Serper.dev, used for RAG web search (app/search.py). Without
# it, web search silently falls back to scraping DuckDuckGo HTML.
WEB_SEARCH_API_KEY=

# Set to "1" only in automated tests -- disables the slowapi rate limiter.
# Do not set this in a real deployment.
TESTING=

# Target URL the Streamlit dashboard (app/dashboard.py) talks to.
BACKEND_URL=http://localhost:8000
