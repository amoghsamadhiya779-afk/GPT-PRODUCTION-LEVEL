# .env.example — GPT-PRODUCTION-LEVEL backend (app/)
#
# Copy to .env for local development, or set these in your deployment
# platform's environment settings (e.g. Hugging Face Space secrets/variables).
# None of these are read from a .env file automatically by the app itself --
# they're plain os.environ lookups, so export them however your shell/host
# supports (`python-dotenv`, HF Space secrets, docker-compose `environment:`, etc).

# Path to the base model checkpoint. If unset, falls back to
# checkpoints/best_model.pt, then checkpoints_tiny/best_model.pt, then an
# untrained dummy model while real weights download in the background.
MODEL_CHECKPOINT=checkpoints/best_model.pt

# Name of a LoRA adapter (checkpoints/adapters/<name>.pt) to auto-activate on
# top of the base checkpoint at startup, e.g. an SFT instruction-tuning
# adapter. Optional.
DEFAULT_ADAPTER=sft_v1_small

# Comma-separated list of origins allowed by CORS. Must include your deployed
# frontend's exact origin (scheme + host, no path) or browser requests from
# it will be blocked.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# API key for Serper.dev, used for RAG web search (app/search.py). Without
# it, web search silently falls back to scraping DuckDuckGo HTML.
WEB_SEARCH_API_KEY=

# Optional dense re-ranking of search results (app/retrieval.py): a
# sentence-transformers model name, e.g. sentence-transformers/all-MiniLM-L6-v2
# (requires `pip install sentence-transformers`). Unset = lexical ranking only.
# RAG_DENSE_WEIGHT is the dense share of the fused score (0..1, default 0.5,
# untuned) -- check it with `python -m evals --suites retrieval`.
RAG_EMBED_MODEL=
RAG_DENSE_WEIGHT=0.5

# Bearer token for operator-only endpoints: reading collected feedback
# (GET /feedback) and changing the server-wide default adapter
# (POST /adapters/{name}/activate, POST /adapters/deactivate). Those endpoints
# are disabled entirely while this is unset. Generate one with e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and send it as `Authorization: Bearer <key>`. Keep it server-side only --
# never put it in a NEXT_PUBLIC_* variable.
ADMIN_API_KEY=

# Number of reverse proxies in front of the API (Hugging Face Spaces, a load
# balancer, a CDN). Rate limits key on the client IP; behind a proxy every
# request otherwise appears to come from the proxy, so all users would share
# one bucket. Leave at 0 when clients connect directly -- a non-zero value
# with no proxy in front lets clients spoof their IP via X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# Continuous batching: up to ENGINE_MAX_BATCH generations share every forward
# pass (default 8 on CPU, 16 on GPU). Beyond that, at most ENGINE_MAX_QUEUE
# requests wait for a slot (others get an immediate 503 with Retry-After),
# each for at most ENGINE_QUEUE_TIMEOUT seconds.
ENGINE_MAX_BATCH=8
ENGINE_MAX_QUEUE=8
ENGINE_QUEUE_TIMEOUT=30

# Distinct LoRA adapters that can be resident (and batched together) at once;
# minimum 2. When all are pinned by running requests, a request for another
# adapter waits its turn.
ENGINE_MAX_ADAPTERS=8

# Weight / KV-cache precision: auto (bf16 on GPUs that support it, else fp16
# on CUDA, fp32 on CPU), float32, bfloat16 or float16.
MODEL_DTYPE=auto

# Hard cap on request body size in bytes (checked before JSON parsing).
MAX_REQUEST_BYTES=2097152

# Teach Mode storage limits: max adapters on disk, max feedback log size.
MAX_TEACH_ADAPTERS=50
FEEDBACK_MAX_BYTES=20971520

# Optional: pin the Hugging Face commit the base GPT-2 weights are downloaded
# from (training/load_pretrained.py), instead of whatever "main" points to.
HF_MODEL_REVISION=

# Set to "1" only in automated tests -- disables the slowapi rate limiter.
# Do not set this in a real deployment.
TESTING=

# Target URL the Streamlit dashboard (app/dashboard.py) talks to.
BACKEND_URL=http://localhost:8000
